<h2>Admin Dashboard</h2>

<div class="tabs">
  <button onclick="showTab('users')">Users</button>
  <% if (isSuperAdmin) { %>
    <button onclick="showTab('services')">Services</button>
  <% } %>
</div>

<div id="tab-users" class="tab">
  <input id="search" placeholder="Search users..." oninput="filterUsers()" />

  <table>
    <thead>
      <tr>
        <th>Username</th>
        <th>Role</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="user-table">
      <% users.forEach(u => { %>
        <tr data-name="<%= u.username.toLowerCase() %>">
          <td><%= u.username %></td>
          <td>
            <% if (isSuperAdmin) { %>
              <select onchange="setRole(<%= u.id %>, this.value)">
                <option value="user" <%= u.role==='user'?'selected':'' %>>User</option>
                <option value="admin" <%= u.role==='admin'?'selected':'' %>>Admin</option>
              </select>
            <% } else { %>
              <%= u.role %>
            <% } %>
          </td>
          <td>
            <% if (u.is_disabled) { %>
              Disabled
            <% } else if (u.must_reset_password) { %>
              Reset Required
            <% } else { %>
              Active
            <% } %>
          </td>
          <td>
            <button onclick="disableUser(<%= u.id %>)">Disable</button>
            <button onclick="enableUser(<%= u.id %>)">Enable</button>
            <button onclick="resetPassword(<%= u.id %>)">Reset PW</button>
            <button onclick="forceReset(<%= u.id %>)">Force Reset</button>
            <% if (isSuperAdmin) { %>
              <button onclick="deleteUser(<%= u.id %>)">Delete</button>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (isSuperAdmin) { %>
  <h3>Create User</h3>
  <form onsubmit="createUser(event)">
    <input name="username" placeholder="Username" required />
    <input name="password" type="password" placeholder="Password" required />
    <button>Create</button>
  </form>
  <% } %>
</div>

<% if (isSuperAdmin) { %>
<div id="tab-services" class="tab hidden">
  <h3>Services</h3>

  <% services.forEach(s => { %>
    <div>
      <%= s.name %> (<%= s.min_role %>)
      <button onclick="deleteService(<%= s.id %>)">Delete</button>
    </div>
  <% }) %>

  <form onsubmit="createService(event)">
    <input name="name" placeholder="Name" required />
    <input name="path" placeholder="Path" required />
    <select name="min_role">
      <option value="user">User</option>
      <option value="admin">Admin</option>
    </select>
    <button>Add</button>
  </form>
</div>
<% } %>

<script>
function showTab(name) {
  document.querySelectorAll('.tab').forEach(t => t.classList.add('hidden'));
  document.getElementById('tab-' + name).classList.remove('hidden');
}

function filterUsers() {
  const val = document.getElementById('search').value.toLowerCase();
  document.querySelectorAll('#user-table tr').forEach(r => {
    r.style.display = r.dataset.name.includes(val) ? '' : 'none';
  });
}

async function api(url, body) {
  return fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
}

async function createUser(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));
  const res = await api('/admin/user', data);
  location.reload();
}

async function deleteUser(id) {
  if (!confirm('Delete user?')) return;
  await api('/admin/user/delete', { userId:id });
  location.reload();
}

async function setRole(id, role) {
  await api('/admin/user/role', { userId:id, role });
}

async function disableUser(id) {
  await api('/admin/user/disable', { userId:id, mode:'permanent' });
  location.reload();
}

async function enableUser(id) {
  await api('/admin/user/enable', { userId:id });
  location.reload();
}

async function resetPassword(id) {
  const res = await api('/admin/user/reset-password', { userId:id });
  const json = await res.json();
  alert('Temp password: ' + json.password);
}

async function forceReset(id) {
  await api('/admin/user/force-reset', { userId:id });
  alert('User will reset password on next login');
}

async function createService(e) {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(e.target));
  await api('/admin/service', data);
  location.reload();
}

async function deleteService(id) {
  await api('/admin/service/delete', { serviceId:id });
  location.reload();
}
</script>

<style>
.tab.hidden { display:none; }
table { width:100%; }
th,td { padding:6px; }
</style>
