<link rel="stylesheet" href="/css/profile.css">
<link rel="stylesheet" href="/css/admin.css">

<div class="page-container">
  <h2>Admin Dashboard</h2>

  <div class="profile-panel">
    <div class="tabs">
      <button type="button" data-tab="users" class="active">Users</button>
      <% if (isSuperAdmin) { %>
        <button type="button" data-tab="services">Services</button>
      <% } %>
    </div>
  </div>

  <!-- USERS TAB -->
  <div id="tab-users" class="tab">

    <!-- Users List -->
    <div class="profile-panel">
      <h3>Users</h3>

      <div class="stack-form compact-form">
        <input id="search" placeholder="Search users..." />
      </div>

      <div class="table-container">
        <table class="styled-table">
          <thead>
            <tr>
              <th>Username</th>
              <th>Role</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="user-table">
            <% users.forEach(u => { %>
              <tr data-name="<%= (u.username || '').toLowerCase() %>">
                <td><%= u.username %></td>
                <td>
                  <% if (isSuperAdmin) { %>
                    <select class="role-select" data-id="<%= u.id %>">
                      <option value="user" <%= u.role === "user" ? "selected" : "" %>>User</option>
                      <option value="admin" <%= u.role === "admin" ? "selected" : "" %>>Admin</option>
                    </select>
                  <% } else { %>
                    <%= u.role %>
                  <% } %>
                </td>
                <td>
                  <% if (u.is_disabled) { %>
                    Disabled
                  <% } else if (u.must_reset_password) { %>
                    Reset Required
                  <% } else { %>
                    Active
                  <% } %>
                </td>
                <td class="actions-cell">
                  <button type="button" class="secondary disable-btn" data-id="<%= u.id %>">Disable</button>
                  <button type="button" class="secondary enable-btn" data-id="<%= u.id %>">Enable</button>
                  <button type="button" class="secondary reset-btn" data-id="<%= u.id %>">Reset PW</button>
                  <button type="button" class="secondary force-reset-btn" data-id="<%= u.id %>">Force Reset</button>
                  <% if (isSuperAdmin) { %>
                    <button type="button" class="secondary delete-btn" data-id="<%= u.id %>">Delete</button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Create User Section -->
    <% if (isSuperAdmin) { %>
      <div class="profile-panel">
        <h3>Create User</h3>
        <form id="create-user-form" class="stack-form">
          <input name="username" placeholder="Username" required />
          <button type="submit">Create User</button>
        </form>
      </div>
    <% } %>

  </div>

  <!-- SERVICES TAB -->
  <% if (isSuperAdmin) { %>
    <div id="tab-services" class="tab hidden">

      <!-- Services List -->
      <div class="profile-panel">
        <h3>Services</h3>

        <% services.forEach(s => { %>
          <div class="service-row" data-id="<%= s.id %>">

          <div class="service-info view-mode">
            <strong class="service-name"><%= s.name %></strong>

            <div class="service-meta">
              <span class="service-path"><%= s.path %></span>
              <span class="service-role">(<%= s.min_role %>)</span>
            </div>
          </div>

          <!-- ✏️ EDIT MODE -->
          <div class="service-edit hidden">
          <div class="field">
            <input class="edit-name" value="<%= s.name %>" placeholder="Name" />
            <div class="error name-error"></div>
          </div>

          <div class="field">
            <input class="edit-path" value="<%= s.path %>" placeholder="Path or URL" />
            <div class="error path-error"></div>
          </div>

          <select class="edit-role">
            <option value="user" <%= s.min_role === "user" ? "selected" : "" %>>User</option>
            <option value="admin" <%= s.min_role === "admin" ? "selected" : "" %>>Admin</option>
          </select>
        </div>

          <div class="service-actions">
            <button type="button" class="secondary edit-service-btn">Edit</button>
            <button type="button" class="secondary save-service-btn hidden">Save</button>
            <button type="button" class="secondary cancel-service-btn hidden">Cancel</button>
            <button type="button" class="secondary delete-service-btn" data-id="<%= s.id %>">Delete</button>
          </div>

        </div>
        <% }) %>
      </div>

      <!-- Create Service Section -->
      <div class="profile-panel">
        <h3>Create Service</h3>
        <form id="create-service-form" class="stack-form">
          <input name="name" placeholder="Name" required />
          <input name="path" placeholder="Path" required />

          <select name="min_role">
            <option value="user">User</option>
            <option value="admin">Admin</option>
          </select>
          <button type="submit">Add Service</button>
        </form>
      </div>

    </div>
  <% } %>

</div>

<script src="/js/admin.js"></script>
