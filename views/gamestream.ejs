<div class="gamestream-page">
  <div class="subheader">ChadStream</div>

  <div class="container">
    <div class="wrapper">
      <video id="video" autoplay playsinline controls></video>

      <div class="controls">
        <button class="btn" onclick="toggleFullscreen()">Fullscreen</button>
      </div>
    </div>
  </div>

  <div class="stream-footer">
    <button onclick="switchStream(0)" class="active">Main Board</button>
    <button onclick="switchStream(1)">Player #1</button>
    <button onclick="switchStream(2)">Player #2</button>
    <button onclick="switchStream(3)">Player #3</button>
    <button onclick="switchStream(4)">Player #4</button>
  </div>
</div>

<style>
  .gamestream-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .subheader {
    text-align: center;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--text);
    margin-top: 0.5rem;
  }

  .container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0.5rem 0;
    flex-direction: column;
  }

  .wrapper {
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 16 / 9;
    background: black;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.10);
    position: relative;
    border: 1px solid #1e293b;
  }

  video {
    width: 100%;
    height: 100%;
    background: black;
  }

  .stream-footer {
    background: var(--header);
    border: 1px solid #1e293b;
    border-radius: 12px;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 12px;
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
  }

  .stream-footer button {
    background: rgba(255,255,255,0.04);
    border: 1px solid #2a3b52;
    color: var(--muted);
    padding: 8px 14px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
  }

  .stream-footer button.active {
    border-color: var(--accent);
    color: var(--accent);
  }

  .stream-footer button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .controls {
    position: absolute;
    top: 10px;
    right: 10px;
  }

  .btn {
    background: rgba(0,0,0,0.6);
    color: var(--text);
    border: 1px solid rgba(255,255,255,0.2);
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .subheader {
      font-size: 1.2rem;
    }
  }
</style>

<script>
  const streams = [
    "https://YOUR_SRS_SERVER/live/main/whep",
    "https://YOUR_SRS_SERVER/live/p1/whep",
    "https://YOUR_SRS_SERVER/live/p2/whep",
    "https://YOUR_SRS_SERVER/live/p3/whep",
    "https://YOUR_SRS_SERVER/live/p4/whep"
  ];

  let pc = null;
  let current = 0;

  const video = document.getElementById("video");

  function createPC() {
    return new RTCPeerConnection({
      iceTransportPolicy: "all",
      bundlePolicy: "max-bundle",
      rtcpMuxPolicy: "require",
      sdpSemantics: "unified-plan"
    });
  }

  function closePC() {
    if (pc) pc.close();
    pc = null;
  }

  async function startStream(i) {
    closePC();

    pc = createPC();
    pc.ontrack = e => video.srcObject = e.streams[0];

    const offer = await pc.createOffer({
      offerToReceiveAudio: true,
      offerToReceiveVideo: true
    });

    await pc.setLocalDescription(offer);

    const res = await fetch(streams[i], {
      method: "POST",
      headers: { "Content-Type": "application/sdp" },
      body: offer.sdp
    });

    const answer = await res.text();
    await pc.setRemoteDescription({ type: "answer", sdp: answer });
  }

  function switchStream(i) {
    current = i;
    startStream(i);

    document.querySelectorAll(".stream-footer button").forEach((b, idx) => {
      b.classList.toggle("active", idx === i);
    });
  }

  function toggleFullscreen() {
    const el = document.querySelector(".wrapper");
    if (!document.fullscreenElement) el.requestFullscreen();
    else document.exitFullscreen();
  }

  switchStream(0);
</script>
