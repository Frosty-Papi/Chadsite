<header id="top-nav">
  <div class="nav-container">

    <a class="logo" href="/">ChadBroChill</a>

    <nav>

      <% services.forEach(service => { %>
        <% if (service.is_external) { %>
          <a href="<%= service.path %>" target="_blank">
            <%= service.name %>
          </a>
        <% } else { %>
          <a href="<%= service.path %>">
            <%= service.name %>
          </a>
        <% } %>
      <% }) %>

      <div id="auth-area">

        <% if (!user) { %>
          <a href="/login" class="login-btn">Login</a>
        <% } else { %>
          <div class="profile-menu">

            <button type="button" class="profile-trigger">
              <% if (user.avatar) { %>
                <img src="<%= user.avatar %>" class="avatar-img" />
              <% } else { %>
                <div class="profile-icon">
                  <%= (user.display_name || user.username).charAt(0).toUpperCase() %>
                </div>
              <% } %>

              <span class="profile-name">
                <%= user.display_name || user.username %>
              </span>
            </button>

            <div id="profile-dropdown" class="dropdown">
              <a href="/profile" class="dropdown-item">Profile</a>

              <% if (user.role === "admin" || user.role === "super_admin") { %>
                <a href="/admin" class="dropdown-item">Admin</a>
              <% } %>

              <form method="POST" action="/logout">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="dropdown-item logout">Logout</button>
              </form>
            </div>

          </div>
        <% } %>

        <!-- 🔔 Notifications INSIDE auth-area -->
        <% if (user) { %>
          <div id="notif-bell" class="notif-bell hidden">
            🔔 <span id="notif-count" class="notif-count"></span>
          </div>

          <div id="notif-panel" class="notif-panel hidden">
            <h4>Notifications</h4>
            <ul id="notif-list"></ul>
          </div>
        <% } %>

      </div>
      <div id="toast-container"></div>
    </nav>

  </div>

</header>
