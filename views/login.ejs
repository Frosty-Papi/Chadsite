<div class="login-wrapper">

  <div class="login-card">

    <h1 class="title">ChadBroChill</h1>
    <p class="subtitle">Sign in to continue</p>

    <form method="POST" action="/login" class="login-form">

      <label>Username</label>
      <input name="username" type="text" required />

      <label>Password</label>
      <input name="password" type="password" required />

      <button type="submit">Login</button>

    </form>

    <% if (typeof error !== "undefined") { %>
      <p class="error"><%= error %></p>
    <% } %>

  </div>

</div>

<style>
.login-wrapper {
  min-height: calc(100vh - 120px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.login-card {
  width: 100%;
  max-width: 420px;
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 14px;
  padding: 2rem;
  text-align: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.35);
}

.title {
  color: #38bdf8;
  font-size: 1.6rem;
  margin-bottom: 0.25rem;
}

.subtitle {
  color: #94a3b8;
  margin-bottom: 1.5rem;
  font-size: 0.9rem;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  text-align: left;
}

label {
  font-size: 0.85rem;
  color: #94a3b8;
}

input {
  padding: 0.6rem;
  border-radius: 6px;
  border: 1px solid #1e293b;
  background: #0f172a;
  color: #e2e8f0;
  outline: none;
}

input:focus {
  border-color: #38bdf8;
}

button {
  margin-top: 1rem;
  padding: 0.6rem;
  background: #38bdf8;
  border: none;
  border-radius: 6px;
  color: #020617;
  font-weight: bold;
  cursor: pointer;
  transition: 0.2s ease;
}

button:hover {
  opacity: 0.9;
}

.error {
  margin-top: 1rem;
  color: #f87171;
  font-size: 0.85rem;
}
</style>
